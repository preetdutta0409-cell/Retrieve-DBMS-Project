# Copy this file to .env and replace the values.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://retrieve_user:YOUR_DB_PASSWORD@localhost/retrieve_db
# Optional, for creating an admin account:
